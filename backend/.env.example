# Hosted Gemma (recommended for deployment). Get a key at https://aistudio.google.com/apikey
GEMMA_API_KEY=
GEMMA_API_MODEL=gemma-3-27b-it

# Local alternative (used if no API key is set)
OLLAMA_HOST=http://localhost:11434
ROAST_TEXT_MODEL=gemma2:2b

# Set to 1 to always use the offline mock engine
ROAST_FORCE_MOCK=

GITHUB_TOKEN=
CORS_ORIGINS=http://localhost:3000
